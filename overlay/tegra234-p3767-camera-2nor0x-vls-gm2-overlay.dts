&cam_i2c_1 {
	des_1: max96724_b@4e {
		#address-cells = <1>;
		#size-cells = <0>;

		compatible = "maxim,max96724_tn";
		reg = <0x4e>;
		phy-reg = <0x2e>;

		reset-gpios = <&gpio CAM1_PWDN GPIO_ACTIVE_HIGH>;

		//i2c addr alias map "serializer0, serializer1, serializer2, serializer3"
		i2c-addr-alias-map-local = <0x41 0x42 0x43 0x44>;
		i2c-addr-alias-map-remote = <0x40 0x40 0x40 0x40>;
		i2c-addr-alias-source-id = <1 1 1 1>;

		gpio-controller;
		#gpio-cells = <2>;
		gpio-ranges = <&des_1 0 0 8>;

		// fsync-mode = "internal";

		i2c-mux {
			#address-cells = <1>;
			#size-cells = <0>;

			des_1_i2c_0: i2c@0 {
				#address-cells = <1>;
				#size-cells = <0>;

				reg = <0>;
			};

			des_1_i2c_1: i2c@1 {
				#address-cells = <1>;
				#size-cells = <0>;

				reg = <1>;
			};

			des_1_i2c_2: i2c@2 {
				#address-cells = <1>;
				#size-cells = <0>;

				reg = <2>;
			};

			des_1_i2c_3: i2c@3 {
				#address-cells = <1>;
				#size-cells = <0>;

				reg = <3>;
			};
		};

		phy@1 {
			reg = <1>;
		};

		pipe@0 {
			reg = <0>;

			maxim,phy-id = <CAM4_DES_PHY_ID>;
		};

		pipe@1 {
			reg = <1>;

			maxim,phy-id = <CAM5_DES_PHY_ID>;
		};

		pipe@2 {
			reg = <2>;

			maxim,phy-id = <CAM6_DES_PHY_ID>;
		};

		pipe@3 {
			reg = <3>;

			maxim,phy-id = <CAM7_DES_PHY_ID>;
		};

