						endpoint {
							status = "disabled";
							vc-id = <0x00>;
							port-index = <0x00>;
							bus-width = <0x04>;
							remote-endpoint = <0x02>;
							phandle = <0x13>;
						};
					};

					port@1 {
						reg = <0x01>;
						status = "disabled";

						endpoint {
							status = "disabled";
							vc-id = <0x01>;
							port-index = <0x00>;
							bus-width = <0x04>;
							remote-endpoint = <0x03>;
							phandle = <0x15>;
						};
					};

					port@2 {
						reg = <0x02>;
						status = "disabled";

						endpoint {
							status = "disabled";
							vc-id = <0x02>;
							port-index = <0x00>;
							bus-width = <0x04>;
							remote-endpoint = <0x04>;
							phandle = <0x17>;
						};
					};

					port@3 {
						reg = <0x03>;
						status = "disabled";

						endpoint {
							status = "disabled";
							vc-id = <0x03>;
							port-index = <0x00>;
							bus-width = <0x04>;
							remote-endpoint = <0x05>;
							phandle = <0x19>;
						};
					};

					port@4 {
