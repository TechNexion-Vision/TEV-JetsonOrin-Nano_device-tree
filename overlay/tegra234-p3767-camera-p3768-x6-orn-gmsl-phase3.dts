/dts-v1/;

/*
 * X6-ORN GMSL phase 3 serializer-only overlay.
 *
 * This source is based on the proven phase 1 combined overlay, but starts
 * replacing the borrowed G300/FG96 camera topology with the X6 routing plan.
 *
 * Current phase 3 scope:
 * - keep Path A max9296a bind and X6 MFP4 power init;
 * - keep Path A MAX9296A channel skeleton on serial_a/port-index 0;
 * - add one Path A MAX96717 serializer alias and node;
 * - disable old G300 sensor nodes and tegra-camera-platform modules;
 * - disable Path B until Path A has a coherent media graph;
 * - do not add final sensor nodes until exact parts are known.
 */

/ {
	overlay-name = "X6-ORN GMSL phase 3 serializer";
	jetson-header-name = "Jetson 40pin Header";
	compatible = "nvidia,p3768-0000+p3767-0000\0nvidia,p3768-0000+p3767-0001\0nvidia,p3768-0000+p3767-0003\0nvidia,p3768-0000+p3767-0004\0nvidia,p3768-0000+p3767-0005\0nvidia,p3768-0000+p3767-0000-super\0nvidia,p3768-0000+p3767-0001-super\0nvidia,p3768-0000+p3767-0003-super\0nvidia,p3768-0000+p3767-0004-super\0nvidia,p3768-0000+p3767-0005-super";

	fragment@0 {
		target = <0xffffffff>;

		__overlay__ {
			pinctrl-names = "default";
			pinctrl-0 = <0x01>;

			exp-header-pinmux {
				phandle = <0x01>;

				hdr40-pin15 {
					nvidia,pins = "soc_gpio39_pn1";
					nvidia,function = "gp";
					nvidia,pin-group = "pwm1";
					nvidia,tristate = <0x00>;
					nvidia,enable-input = <0x00>;
				};
			};
		};
	};

	fragment@1 {
		target-path = "/";

		__overlay__ {

			tegra-capture-vi {
				num-channels = <0x10>;

				ports {
					status = "disabled";
