/dts-v1/;
/plugin/;

#include <dt-bindings/tegra234-p3767-0000-common.h>
#include <dt-bindings/pinctrl/pinctrl-tegra.h>

#define CAM0_PWDN		TEGRA234_MAIN_GPIO(H, 6)
#define CAM1_PWDN		TEGRA234_MAIN_GPIO(AC, 0)

#define CAM_I2C_MUX 	TEGRA234_AON_GPIO(CC, 3)

#define CAM_NUM 4

#define CAM0_PORT 				0
#define CAM0_LANES 				4
#define CAM0_VC_ID 				0
#define CAM0_LANES_STRING 		"4"
#define CAM0_SINTERFACE			"serial_a"
#define CAM0_LANE_POLARITY		"6"
#define CAM0_PIXEL_CLK			"200000000"
#define CAM0_SERDES_PIXEL_CLK	"500000000"
#define CAM0_DES_PHY_ID			0

#define CAM1_PORT 				0
#define CAM1_LANES 				4
#define CAM1_VC_ID 				1
#define CAM1_LANES_STRING 		"4"
#define CAM1_SINTERFACE			"serial_a"
#define CAM1_LANE_POLARITY		"6"
#define CAM1_PIXEL_CLK			"200000000"
#define CAM1_SERDES_PIXEL_CLK	"500000000"
#define CAM1_DES_PHY_ID			0

#define CAM2_PORT 				2
#define CAM2_LANES 				4
#define CAM2_VC_ID 				0
#define CAM2_LANES_STRING 		"4"
#define CAM2_SINTERFACE			"serial_c"
#define CAM2_LANE_POLARITY		"0"
#define CAM2_PIXEL_CLK			"200000000"
#define CAM2_SERDES_PIXEL_CLK	"500000000"
#define CAM2_DES_PHY_ID			0

#define CAM3_PORT 				2
#define CAM3_LANES 				4
#define CAM3_VC_ID 				1
#define CAM3_LANES_STRING 		"4"
#define CAM3_SINTERFACE			"serial_c"
#define CAM3_LANE_POLARITY		"0"
#define CAM3_PIXEL_CLK			"200000000"
#define CAM3_SERDES_PIXEL_CLK	"500000000"
#define CAM3_DES_PHY_ID			0

#define DES_LINK_FREQ			1000000000
#define TEVS_LINK_FREQ			400000000

#define TEVS_MODE_COMMON(LANES, SINTERFACE, LANE_POLARITY, PIXEL_CLK, SERDES_PIXEL_CLK)	\
	mclk_khz = "24000";							\
	num_lanes = LANES;							\
	tegra_sinterface = SINTERFACE;				\
	lane_polarity = LANE_POLARITY;				\
	phy_mode = "DPHY";							\
	discontinuous_clk = "no";					\
	dpcm_enable = "false";						\
	cil_settletime = "0";						\
	mode_type = "yuv";							\
	pixel_phase = "uyvy";						\
	csi_pixel_bit_depth = "16";					\
	readout_orientation = "90";					\
	line_length = "3448";						\
	inherent_gain = "1";						\
	mclk_multiplier = "9.33";					\
	pix_clk_hz = PIXEL_CLK;						\
	serdes_pix_clk_hz = SERDES_PIXEL_CLK;		\
	gain_factor = "16";							\
	framerate_factor = "1000000";				\
	exposure_factor = "1000000";				\
	min_gain_val = "16";						\
	max_gain_val = "170";						\
	step_gain_val = "1";						\
	default_gain = "16";						\
	min_hdr_ratio = "1";						\
	max_hdr_ratio = "1";						\
	min_framerate = "2000000";					\
	step_framerate = "1";						\
	min_exp_time = "13";						\
	max_exp_time = "683709";					\
	step_exp_time = "1";						\
	default_exp_time = "2495";					\
	embedded_metadata_height = "0";

#define TEVS_MODES(LANES, SINTERFACE, LANE_POLARITY, PIXEL_CLK, SERDES_PIXEL_CLK)	\
	mode0 {										\
		TEVS_MODE_COMMON(LANES, SINTERFACE, LANE_POLARITY, PIXEL_CLK, SERDES_PIXEL_CLK)	\
		active_w = "3280";						\
		active_h = "2464";						\
		max_framerate = "21000000";				\
		default_framerate = "21000000";			\
	};											\
	mode1 {										\
		TEVS_MODE_COMMON(LANES, SINTERFACE, LANE_POLARITY, PIXEL_CLK, SERDES_PIXEL_CLK)	\
		active_w = "3280";						\
		active_h = "1848";						\
		max_framerate = "28000000";				\
		default_framerate = "28000000";			\
	};											\
	mode2 {										\
		TEVS_MODE_COMMON(LANES, SINTERFACE, LANE_POLARITY, PIXEL_CLK, SERDES_PIXEL_CLK)	\
		active_w = "1920";						\
		active_h = "1080";						\
		max_framerate = "30000000";				\
		default_framerate = "30000000";			\
	};											\
	mode3 {										\
		TEVS_MODE_COMMON(LANES, SINTERFACE, LANE_POLARITY, PIXEL_CLK, SERDES_PIXEL_CLK)	\
		active_w = "1640";						\
		active_h = "1232";						\
		max_framerate = "30000000";				\
		default_framerate = "30000000";			\
	};											\
	mode4 {										\
		TEVS_MODE_COMMON(LANES, SINTERFACE, LANE_POLARITY, PIXEL_CLK, SERDES_PIXEL_CLK)	\
		active_w = "1280";						\
		active_h = "720";						\
		max_framerate = "60000000";				\
		default_framerate = "60000000";			\
	};											\
	mode5 {										\
		TEVS_MODE_COMMON(LANES, SINTERFACE, LANE_POLARITY, PIXEL_CLK, SERDES_PIXEL_CLK)	\
		active_w = "640";						\
		active_h = "480";						\
		max_framerate = "60000000";				\
		default_framerate = "60000000";			\
	};

/ {
	overlay-name = "TechNexion VLS-GM2 Camera with FSYNC Pixel Mode";
	jetson-header-name = "Jetson 24pin CSI Connector";

	fragment@0 {
		target = <&pinmux>;
		__overlay__ {
			pinctrl-names = "default";
			pinctrl-0 = <&jetson_io_pinmux>;
			jetson_io_pinmux: exp-header-pinmux {
				uart4_cts_ph6 {
					nvidia,pins = "uart4_cts_ph6";
					nvidia,function = "rsvd1";
					nvidia,pin-label = "cam_pwdn0";
					nvidia,pull = <TEGRA_PIN_PULL_UP>;
					nvidia,tristate = <TEGRA_PIN_DISABLE>;
					nvidia,enable-input = <TEGRA_PIN_DISABLE>;
				};
				spi5_sck_pac0 {
					nvidia,pins = "spi5_sck_pac0";
					nvidia,function = "rsvd3";
					nvidia,pin-group = "cam_pwdn1";
					nvidia,pull = <TEGRA_PIN_PULL_UP>;
					nvidia,tristate = <TEGRA_PIN_DISABLE>;
					nvidia,enable-input = <TEGRA_PIN_ENABLE>;
				};
			};
		};
	};

	fragment-camera-tevs@1 {
		target-path = "/";
		__overlay__ {
			tegra-capture-vi  {
				num-channels = <CAM_NUM>;
				ports {
					#address-cells = <1>;
					#size-cells = <0>;

					vi_port0: port@0 {
						reg = <0>;

						vi_in0: endpoint {
							vc-id = <CAM0_VC_ID>;
							port-index = <CAM0_PORT>;
							bus-width = <CAM0_LANES>;
							remote-endpoint = <&csi_0_out>;
						};
					};

					vi_port1: port@1 {
						reg = <1>;

						vi_in1: endpoint {
							vc-id = <CAM1_VC_ID>;
							port-index = <CAM1_PORT>;
							bus-width = <CAM1_LANES>;
							remote-endpoint = <&csi_1_out>;
						};
					};

					vi_port2: port@2 {
						reg = <2>;

						vi_in2: endpoint {
							vc-id = <CAM2_VC_ID>;
							port-index = <CAM2_PORT>;
							bus-width = <CAM2_LANES>;
							remote-endpoint = <&csi_2_out>;
						};
					};

					vi_port3: port@3 {
						reg = <3>;

						vi_in3: endpoint {
							vc-id = <CAM3_VC_ID>;
							port-index = <CAM3_PORT>;
							bus-width = <CAM3_LANES>;
							remote-endpoint = <&csi_3_out>;
						};
					};
				};
			};

			tcp: tegra-camera-platform {
				compatible = "nvidia, tegra-camera-platform";
				/**
				* Physical settings to calculate max ISO BW
				*
				* num_csi_lanes = <>;
				* Total number of CSI lanes when all cameras are active
				*
				* max_lane_speed = <>;
				* Max lane speed in Kbit/s
				*
				* min_bits_per_pixel = <>;
				* Min bits per pixel
				*
				* vi_peak_byte_per_pixel = <>;
				* Max byte per pixel for the VI ISO case
				*
				* vi_bw_margin_pct = <>;
				* Vi bandwidth margin in percentage
				*
				* max_pixel_rate = <>;
				* Max pixel rate in Kpixel/s for the ISP ISO case
				*
				* isp_peak_byte_per_pixel = <>;
				* Max byte per pixel for the ISP ISO case
				*
				* isp_bw_margin_pct = <>;
				* Isp bandwidth margin in percentage
				*/
				num_csi_lanes = <8>;
				max_lane_speed = <2500000>;
				min_bits_per_pixel = <16>;
				vi_peak_byte_per_pixel = <2>;
				vi_bw_margin_pct = <25>;
				// max_pixel_rate = <240000>;
				// isp_peak_byte_per_pixel = <5>;
				// isp_bw_margin_pct = <25>;

				/**
				 * The general guideline for naming badge_info contains 3 parts, and is as follows,
				 * The first part is the camera_board_id for the module; if the module is in a FFD
				 * platform, then use the platform name for this part.
				 * The second part contains the position of the module, ex. "rear" or "front".
				 * The third part contains the last 6 characters of a part number which is found
				 * in the module's specsheet from the vendor.
				 */
				modules {
					module0 {
						badge = "jakku_front_RBP194";
						position = "front";
						orientation = "1";
						drivernode0 {
							pcl_id = "v4l2_sensor";
							sysfs-device-tree = "/sys/firmware/devicetree/base/bus@0/i2c@3180000/rpi22_tevs_a@39";
						};
					};

					module1 {
						badge = "jakku_front_RBP194";
						position = "front";
						orientation = "1";
						drivernode0 {
							pcl_id = "v4l2_sensor";
							sysfs-device-tree = "/sys/firmware/devicetree/base/bus@0/i2c@3180000/rpi22_tevs_b@3a";
						};
					};

					module2 {
						badge = "jakku_front_RBP194";
						position = "front";
						orientation = "1";
						drivernode0 {
							pcl_id = "v4l2_sensor";
							sysfs-device-tree = "/sys/firmware/devicetree/base/bus@0/i2c@3180000/rpi22_tevs_c@3b";
						};
					};

					module3 {
						badge = "jakku_front_RBP194";
						position = "front";
						orientation = "1";
						drivernode0 {
							pcl_id = "v4l2_sensor";
							sysfs-device-tree = "/sys/firmware/devicetree/base/bus@0/i2c@3180000/rpi22_tevs_d@3c";
						};
					};
				};
			};

			bus@0 {
				host1x@13e00000 {
					nvcsi@15a00000 {
						#address-cells = <1>;
						#size-cells = <0>;

						num-channels = <CAM_NUM>;

						channel@0 {
							reg = <0>;
							ports {
								#address-cells = <1>;
								#size-cells = <0>;

								port@0 {
									reg = <0>;

									csi_0_in: endpoint@0 {
										port-index = <CAM0_PORT>;
										bus-width = <CAM0_LANES>;
										remote-endpoint = <&rpi22_tevs_0_out>;
									};
								};

								port@1 {
									reg = <1>;

									csi_0_out: endpoint@1 {
										remote-endpoint = <&vi_in0>;
									};
								};
							};
						};

						channel@1 {
							reg = <1>;
							ports {
								#address-cells = <1>;
								#size-cells = <0>;

								port@0 {
									reg = <0>;

									csi_1_in: endpoint@2 {
										port-index = <CAM1_PORT>;
										bus-width = <CAM1_LANES>;
										remote-endpoint = <&rpi22_tevs_1_out>;
									};
								};

								port@1 {
									reg = <1>;

									csi_1_out: endpoint@3 {
										remote-endpoint = <&vi_in1>;
									};
								};
							};
						};

						channel@2 {
							reg = <2>;
							ports {
								#address-cells = <1>;
								#size-cells = <0>;

								port@0 {
									reg = <0>;

									csi_2_in: endpoint@4 {
										port-index = <CAM2_PORT>;
										bus-width = <CAM2_LANES>;
										remote-endpoint = <&rpi22_tevs_2_out>;
									};
								};

								port@1 {
									reg = <1>;

									csi_2_out: endpoint@5 {
										remote-endpoint = <&vi_in2>;
									};
								};
							};
						};

						channel@3 {
							reg = <3>;
							ports {
								#address-cells = <1>;
								#size-cells = <0>;

								port@0 {
									reg = <0>;

									csi_3_in: endpoint@6 {
										port-index = <CAM3_PORT>;
										bus-width = <CAM3_LANES>;
										remote-endpoint = <&rpi22_tevs_3_out>;
									};
								};

								port@1 {
									reg = <1>;

									csi_3_out: endpoint@7 {
										remote-endpoint = <&vi_in3>;
									};
								};
							};
						};
					};
				};

				gpio@2200000 {
					camera-control-output-low {
						status = "disabled";
						gpio-hog;
						output-low;
					};
				};

				i2c@3180000 {
					#address-cells = <1>;
					#size-cells = <0>;

					status = "okay";

					des_1: gmsl-deserializer@4a {
						#address-cells = <1>;
						#size-cells = <0>;
						status = "okay";

						compatible = "maxim,max9296a_tn";
						reg = <0x4a>;

						reset-gpios = <&gpio CAM1_PWDN GPIO_ACTIVE_LOW>;

						//i2c addr alias map "serializer0, serializer1"
						i2c-addr-alias-map-local = <0x43 0x44>;
						i2c-addr-alias-map-remote = <0x40 0x40>;
						i2c-addr-alias-source-id = <0 1>;

						gpio-controller;
						#gpio-cells = <2>;
						gpio-ranges = <&des_1 0 0 12>;

						pinctrl-names = "default";
						pinctrl-0 = <&des_1_pinmux_default>;

						fsync-mode = "external";

						des_1_pinmux_default: pinmux {
							mfp6_fsync {
								pins = "mfp6";
								function = "gpio";
								maxim,gmsl-tx = <1>;
								maxim,gmsl-tx-id = <0>;
								input-enable;
							};
						};

						i2c-mux {
							#address-cells = <1>;
							#size-cells = <0>;

							des_1_i2c_0: i2c@0 {
								#address-cells = <1>;
								#size-cells = <0>;

								reg = <0>;
							};

							des_1_i2c_1: i2c@1 {
								#address-cells = <1>;
								#size-cells = <0>;

								reg = <1>;
							};
						};

						phy@0 {
							reg = <0>;
						};

						pipe@0 {
							reg = <0>;

							maxim,phy-id = <CAM2_DES_PHY_ID>;
						};

						pipe@1 {
							reg = <1>;

							maxim,phy-id = <CAM3_DES_PHY_ID>;
						};

						channel@1 {
							reg = <1>;
							label = "des_1_ch_1";

							maxim,phy-id = <CAM3_DES_PHY_ID>;

							clock-lanes = <0>;
							data-lanes = <1 2 3 4>;
							link-frequencies = /bits/ 64 <DES_LINK_FREQ>;
						};

						channel@0 {
							reg = <0>;
							label = "des_1_ch_0";

							maxim,phy-id = <CAM2_DES_PHY_ID>;

							clock-lanes = <0>;
							data-lanes = <1 2 3 4>;
							link-frequencies = /bits/ 64 <DES_LINK_FREQ>;
						};
					};

					des_0: gmsl-deserializer@49 {
						#address-cells = <1>;
						#size-cells = <0>;
						status = "okay";

						compatible = "maxim,max9296a_tn";
						reg = <0x49>;
						phy-reg = <0x48>;

						reset-gpios = <&gpio CAM0_PWDN GPIO_ACTIVE_LOW>;

						//i2c addr alias map "serializer0, serializer1"
						i2c-addr-alias-map-local = <0x41 0x42>;
						i2c-addr-alias-map-remote = <0x40 0x40>;
						i2c-addr-alias-source-id = <0 1>;

						gpio-controller;
						#gpio-cells = <2>;
						gpio-ranges = <&des_0 0 0 12>;

						fsync-mode = "internal-output";
						fsync-freq = <30>;

						i2c-mux {
							#address-cells = <1>;
							#size-cells = <0>;

							des_0_i2c_0: i2c@0 {
								#address-cells = <1>;
								#size-cells = <0>;

								reg = <0>;
							};

							des_0_i2c_1: i2c@1 {
								#address-cells = <1>;
								#size-cells = <0>;

								reg = <1>;
							};
						};

						phy@0 {
							reg = <0>;
						};

						pipe@0 {
							reg = <0>;

							maxim,phy-id = <CAM0_DES_PHY_ID>;
						};

						pipe@1 {
							reg = <1>;

							maxim,phy-id = <CAM1_DES_PHY_ID>;
						};

						channel@1 {
							reg = <1>;
							label = "des_0_ch_1";

							maxim,phy-id = <CAM1_DES_PHY_ID>;

							clock-lanes = <0>;
							data-lanes = <1 2 3 4>;
							link-frequencies = /bits/ 64 <DES_LINK_FREQ>;
						};

						channel@0 {
							reg = <0>;
							label = "des_0_ch_0";

							maxim,phy-id = <CAM0_DES_PHY_ID>;

							clock-lanes = <0>;
							data-lanes = <1 2 3 4>;
							link-frequencies = /bits/ 64 <DES_LINK_FREQ>;
						};
					};

					cam_3: rpi22_tevs_d@3c {
						compatible = "tn,tevs";
						/* I2C device address */
						reg = <0x3c>;
						status = "okay";

						reset-gpios = <&pca9554_cam_3 4 GPIO_ACTIVE_HIGH>;
						standby-gpios = <&pca9554_cam_3 2 GPIO_ACTIVE_HIGH>;
						technexion,gmsl-ser = <&ser_3>;
						technexion,gmsl-des = <&des_1>;
						technexion,gmsl-des-channel = <1>;
						trigger-mode = <2>;

						/* V4L2 device node location */
						devnode = "video3";
						/* Physical dimensions of sensor */
						physical_w = "3.680";
						physical_h = "2.760";
						sensor_model = "tevs";
						use_sensor_mode_id = "false";

						TEVS_MODES(CAM3_LANES_STRING, CAM3_SINTERFACE, CAM3_LANE_POLARITY, CAM3_PIXEL_CLK, CAM3_SERDES_PIXEL_CLK)

						ports {
							#address-cells = <1>;
							#size-cells = <0>;
							port@0 {
								reg = <0>;

								rpi22_tevs_3_out: endpoint {
									port-index = <CAM3_PORT>;
									bus-width = <CAM3_LANES>;
									remote-endpoint = <&csi_3_in>;
									link-frequencies = /bits/ 64 <TEVS_LINK_FREQ>;
								};
							};
						};
					};

					cam_2: rpi22_tevs_c@3b {
						compatible = "tn,tevs";
						/* I2C device address */
						reg = <0x3b>;
						status = "okay";

						reset-gpios = <&pca9554_cam_2 4 GPIO_ACTIVE_HIGH>;
						standby-gpios = <&pca9554_cam_2 2 GPIO_ACTIVE_HIGH>;
						technexion,gmsl-ser = <&ser_2>;
						technexion,gmsl-des = <&des_1>;
						technexion,gmsl-des-channel = <0>;
						trigger-mode = <2>;

						/* V4L2 device node location */
						devnode = "video2";
						/* Physical dimensions of sensor */
						physical_w = "3.680";
						physical_h = "2.760";
						sensor_model = "tevs";
						use_sensor_mode_id = "false";

						TEVS_MODES(CAM2_LANES_STRING, CAM2_SINTERFACE, CAM2_LANE_POLARITY, CAM2_PIXEL_CLK, CAM2_SERDES_PIXEL_CLK)

						ports {
							#address-cells = <1>;
							#size-cells = <0>;
							port@0 {
								reg = <0>;

								rpi22_tevs_2_out: endpoint {
									port-index = <CAM2_PORT>;
									bus-width = <CAM2_LANES>;
									remote-endpoint = <&csi_2_in>;
									link-frequencies = /bits/ 64 <TEVS_LINK_FREQ>;
								};
							};
						};
					};

					cam_1: rpi22_tevs_b@3a {
						compatible = "tn,tevs";
						/* I2C device address */
						reg = <0x3a>;
						status = "okay";

						reset-gpios = <&pca9554_cam_1 4 GPIO_ACTIVE_HIGH>;
						standby-gpios = <&pca9554_cam_1 2 GPIO_ACTIVE_HIGH>;
						technexion,gmsl-ser = <&ser_1>;
						technexion,gmsl-des = <&des_0>;
						technexion,gmsl-des-channel = <1>;
						trigger-mode = <2>;

						/* V4L2 device node location */
						devnode = "video1";
						/* Physical dimensions of sensor */
						physical_w = "3.680";
						physical_h = "2.760";
						sensor_model = "tevs";
						use_sensor_mode_id = "false";

						TEVS_MODES(CAM1_LANES_STRING, CAM1_SINTERFACE, CAM1_LANE_POLARITY, CAM1_PIXEL_CLK, CAM1_SERDES_PIXEL_CLK)

						ports {
							#address-cells = <1>;
							#size-cells = <0>;
							port@0 {
								reg = <0>;

								rpi22_tevs_1_out: endpoint {
									port-index = <CAM1_PORT>;
									bus-width = <CAM1_LANES>;
									remote-endpoint = <&csi_1_in>;
									link-frequencies = /bits/ 64 <TEVS_LINK_FREQ>;
								};
							};
						};
					};

					cam_0: rpi22_tevs_a@39 {
						compatible = "tn,tevs";
						/* I2C device address */
						reg = <0x39>;
						status = "okay";

						reset-gpios = <&pca9554_cam_0 4 GPIO_ACTIVE_HIGH>;
						standby-gpios = <&pca9554_cam_0 2 GPIO_ACTIVE_HIGH>;
						technexion,gmsl-ser = <&ser_0>;
						technexion,gmsl-des = <&des_0>;
						technexion,gmsl-des-channel = <0>;
						trigger-mode = <2>;

						/* V4L2 device node location */
						devnode = "video0";
						/* Physical dimensions of sensor */
						physical_w = "3.680";
						physical_h = "2.760";
						sensor_model = "tevs";
						use_sensor_mode_id = "false";

						TEVS_MODES(CAM0_LANES_STRING, CAM0_SINTERFACE, CAM0_LANE_POLARITY, CAM0_PIXEL_CLK, CAM0_SERDES_PIXEL_CLK)

						ports {
							#address-cells = <1>;
							#size-cells = <0>;
							port@0 {
								reg = <0>;

								rpi22_tevs_0_out: endpoint {
									port-index = <CAM0_PORT>;
									bus-width = <CAM0_LANES>;
									remote-endpoint = <&csi_0_in>;
									link-frequencies = /bits/ 64 <TEVS_LINK_FREQ>;
								};
							};
						};
					};
				};
			};
		};
	};
};

&des_0_i2c_0 {
	ser_0: gmsl-serializer@41 {
		#address-cells = <1>;
		#size-cells = <0>;
		status = "okay";

		compatible = "maxim,max96717_tn";
		reg = <0x41>;

		// i2c addr alias map "sensor, gpio expander"
		i2c-addr-alias-map-local = <0x39 0x26>;
		i2c-addr-alias-map-remote = <0x48 0x25>;

		gpio-controller;
		#gpio-cells = <2>;
		gpio-ranges = <&ser_0 0 0 11>;

		pinctrl-names = "default";
		pinctrl-0 = <&ser_0_pinmux_default>;

		ser_0_pinmux_default: pinmux {
			mfp0_fsync {
				pins = "mfp0";
				function = "gpio";
				maxim,gmsl-rx = <1>;
				maxim,gmsl-rx-id = <0>;
				output-enable;
				output-low;
			};
		};

		i2c-mux {
			#address-cells = <1>;
			#size-cells = <0>;

			ser_0_i2c_0: i2c@0 {
				#address-cells = <1>;
				#size-cells = <0>;

				reg = <0>;
			};
		};

		pipe@0 {
			reg = <0>;

			maxim,stream-id = <0>;
		};

		channel@0 {
			reg = <0>;
			label = "ser_0_ch_0";

			clock-lanes = <0>;
			data-lanes = <1 2 3 4>;
		};
	};
};

&ser_0_i2c_0 {
	pca9554_cam_0: pca9554@26 {
		compatible = "nxp,pca9554";
		reg = <0x26>;
		gpio-controller;
		#gpio-cells = <2>;
		gpio-line-names = "EXPOSURE_TRIG_IN",
						"FLASH_OUT",
						"INFO_TRIG_IN",
						"CAMA_SHUTTER",
						"CSI_P1_nRST",
						"PWR_TIME0",
						"PWR_TIME1",
						"3V3_EN";
		vcc-supply = <&vdd_1v8_hs>;
		vcc_lp = "vcc";
		status = "okay";
	};
};

