/dts-v1/;
/plugin/;

#include <dt-bindings/tegra234-p3767-0000-common.h>

#define AFE_R750_CAM0_PWDN		TEGRA234_MAIN_GPIO(H, 6)
#define AFE_R750_CAM_I2C_MUX		TEGRA234_AON_GPIO(CC, 3)

#define AFE_R750_CAM_NUM		1
#define AFE_R750_CAM_LANES		2
#define AFE_R750_CAM_LANES_STR		"2"

#define AFE_R750_CAM0_PORT		0
#define AFE_R750_CAM0_SINTERFACE	"serial_a"
#define AFE_R750_DES_PHY_ID		0

#define AFE_R750_DES_LINK_FREQ		1000000000
#define AFE_R750_TEVS_LINK_FREQ		280000000

#define AFE_R750_TEVS_MODE_COMMON					\
	mclk_khz = "24000";						\
	num_lanes = AFE_R750_CAM_LANES_STR;				\
	tegra_sinterface = AFE_R750_CAM0_SINTERFACE;			\
	phy_mode = "DPHY";						\
	discontinuous_clk = "yes";					\
	dpcm_enable = "false";						\
	cil_settletime = "0";						\
	mode_type = "yuv";						\
	pixel_phase = "uyvy";						\
	csi_pixel_bit_depth = "16";					\
	readout_orientation = "90";					\
	line_length = "3448";						\
	inherent_gain = "1";						\
	mclk_multiplier = "9.33";					\
	pix_clk_hz = "70000000";					\
	serdes_pix_clk_hz = "312500000";				\
	gain_factor = "16";						\
	framerate_factor = "1000000";					\
	exposure_factor = "1000000";					\
	min_gain_val = "16";						\
	max_gain_val = "170";						\
	step_gain_val = "1";						\
	default_gain = "16";						\
	min_hdr_ratio = "1";						\
	max_hdr_ratio = "1";						\
	min_framerate = "2000000";					\
	step_framerate = "1";						\
	min_exp_time = "13";						\
	max_exp_time = "683709";					\
	step_exp_time = "1";						\
	default_exp_time = "2495";					\
	embedded_metadata_height = "0";

/ {
	overlay-name = "TechNexion AFE-R750 VLS-GM2 Camera";
	jetson-header-name = "Jetson 24pin CSI Connector";
	compatible = JETSON_COMPATIBLE_P3768;

	fragment-camera-tevs@0 {
		target-path = "/";
		__overlay__ {
			tegra-capture-vi {
				num-channels = <AFE_R750_CAM_NUM>;
				ports {
					#address-cells = <1>;
					#size-cells = <0>;

					vi_port0: port@0 {
						reg = <0>;

						vi_in0: endpoint {
							vc-id = <0>;
							port-index = <AFE_R750_CAM0_PORT>;
							bus-width = <AFE_R750_CAM_LANES>;
							remote-endpoint = <&csi_0_out>;
						};
					};
				};
			};

			tcp: tegra-camera-platform {
				compatible = "nvidia, tegra-camera-platform";

				num_csi_lanes = <AFE_R750_CAM_LANES>;
				max_lane_speed = <1500000>;
				min_bits_per_pixel = <16>;
				vi_peak_byte_per_pixel = <2>;
				vi_bw_margin_pct = <25>;

				modules {
					cam_module0: module0 {
						badge = "afer750_front_RBP194";
						position = "front";
						orientation = "1";
						cam_module0_drivernode0: drivernode0 {
							pcl_id = "v4l2_sensor";
							sysfs-device-tree = "/sys/firmware/devicetree/base/bus@0/cam_i2cmux/i2c@0/rpi22_tevs_a@39";
						};
					};
				};
			};

			bus@0 {
				host1x@13e00000 {
					nvcsi@15a00000 {
						#address-cells = <1>;
						#size-cells = <0>;

						num-channels = <AFE_R750_CAM_NUM>;

						channel@0 {
							reg = <0>;
							ports {
								#address-cells = <1>;
								#size-cells = <0>;

								port@0 {
									reg = <0>;

									csi_0_in: endpoint@0 {
										port-index = <AFE_R750_CAM0_PORT>;
										bus-width = <AFE_R750_CAM_LANES>;
										remote-endpoint = <&rpi22_tevs_0_out>;
									};
								};

								port@1 {
									reg = <1>;

									csi_0_out: endpoint@1 {
										remote-endpoint = <&vi_in0>;
									};
								};
							};
						};
					};
				};

				gpio@2200000 {
					camera-control-output-low {
						status = "disabled";
						gpio-hog;
						output-low;
					};
				};

				cam_i2cmux {
					#address-cells = <1>;
					#size-cells = <0>;

					status = "okay";
					compatible = "i2c-mux-gpio";
					i2c-parent = <&cam_i2c>;
					mux-gpios = <&gpio_aon AFE_R750_CAM_I2C_MUX GPIO_ACTIVE_HIGH>;

					cam_i2c_0: i2c@0 {
						#address-cells = <1>;
						#size-cells = <0>;

						reg = <0>;
						status = "okay";

						rbpcv2_imx219_a@10 {
							status = "disabled";
						};
					};

					cam_i2c_1: i2c@1 {
						#address-cells = <1>;
						#size-cells = <0>;

						reg = <1>;
						status = "disabled";

						rbpcv2_imx219_c@10 {
							status = "disabled";
						};
					};
				};
			};
		};
	};
};

&cam_i2c_0 {
	des_0: max96712_a@29 {
		#address-cells = <1>;
		#size-cells = <0>;

		compatible = "maxim,max96712";
		reg = <0x29>;
		status = "okay";

		reset-gpios = <&gpio AFE_R750_CAM0_PWDN GPIO_ACTIVE_HIGH>;

		i2c-addr-alias-map-local = <0x31>;
		i2c-addr-alias-map-remote = <0x40>;
		i2c-addr-alias-source-id = <0>;

		gpio-controller;
		#gpio-cells = <2>;
		gpio-ranges = <&des_0 0 0 9>;

		i2c-mux {
			#address-cells = <1>;
			#size-cells = <0>;

			compatible = "i2c-mux-gpio";
			i2c-parent = <&cam_i2c>;
			mux-gpios = <&gpio_aon AFE_R750_CAM_I2C_MUX GPIO_ACTIVE_HIGH>;

			des_0_i2c_0: i2c@0 {
				#address-cells = <1>;
				#size-cells = <0>;

				reg = <0>;
				status = "okay";
			};
		};

		phy@0 {
			reg = <0>;
		};

		pipe@0 {
			reg = <0>;

			maxim,link-id = <0>;
			maxim,phy-id = <AFE_R750_DES_PHY_ID>;
			maxim,stream-id = <0>;
		};

		channel@0 {
			reg = <0>;
			label = "des_0_ch_0";

			maxim,pipe-id = <0>;
			maxim,phy-id = <AFE_R750_DES_PHY_ID>;
			maxim,src-vc-id = <0>;
			maxim,dst-vc-id = <0>;

			clock-lanes = <0>;
			data-lanes = <1 2>;
			link-frequencies = /bits/ 64 <AFE_R750_DES_LINK_FREQ>;
		};
	};

	cam_0: rpi22_tevs_a@39 {
		compatible = "tn,tevs";
		reg = <0x39>;
		status = "okay";

		reset-gpios = <&pca9554_cam_0 4 GPIO_ACTIVE_HIGH>;
		standby-gpios = <&pca9554_cam_0 2 GPIO_ACTIVE_HIGH>;

		devnode = "video0";
		physical_w = "3.680";
		physical_h = "2.760";
		sensor_model = "tevs";
		use_sensor_mode_id = "false";

		mode0 {
			AFE_R750_TEVS_MODE_COMMON
			active_w = "3280";
			active_h = "2464";
			max_framerate = "21000000";
			default_framerate = "21000000";
		};

		mode1 {
			AFE_R750_TEVS_MODE_COMMON
			active_w = "3280";
			active_h = "1848";
			max_framerate = "28000000";
			default_framerate = "28000000";
		};

		mode2 {
			AFE_R750_TEVS_MODE_COMMON
			active_w = "1920";
			active_h = "1080";
			max_framerate = "30000000";
			default_framerate = "30000000";
		};

		mode3 {
			AFE_R750_TEVS_MODE_COMMON
			active_w = "1640";
			active_h = "1232";
			max_framerate = "30000000";
			default_framerate = "30000000";
		};

		mode4 {
			AFE_R750_TEVS_MODE_COMMON
			active_w = "1280";
			active_h = "720";
			max_framerate = "60000000";
			default_framerate = "60000000";
		};

		mode5 {
			AFE_R750_TEVS_MODE_COMMON
			active_w = "640";
			active_h = "480";
			max_framerate = "60000000";
			default_framerate = "60000000";
		};

		ports {
			#address-cells = <1>;
			#size-cells = <0>;
			port@0 {
				reg = <0>;

				rpi22_tevs_0_out: endpoint {
					port-index = <AFE_R750_CAM0_PORT>;
					bus-width = <AFE_R750_CAM_LANES>;
					remote-endpoint = <&csi_0_in>;
					clock-noncontinuous;
					link-frequencies = /bits/ 64 <AFE_R750_TEVS_LINK_FREQ>;
				};
			};
		};
	};
};

&des_0_i2c_0 {
	ser_0: max96717_a@31 {
		#address-cells = <1>;
		#size-cells = <0>;

		compatible = "maxim,max96717";
		reg = <0x31>;
		status = "okay";

		i2c-addr-alias-map-local = <0x39 0x21>;
		i2c-addr-alias-map-remote = <0x48 0x25>;

		gpio-controller;
		#gpio-cells = <2>;
		gpio-ranges = <&ser_0 0 0 11>;

		i2c-mux {
			#address-cells = <1>;
			#size-cells = <0>;

			compatible = "i2c-mux-gpio";
			i2c-parent = <&cam_i2c>;
			mux-gpios = <&gpio_aon AFE_R750_CAM_I2C_MUX GPIO_ACTIVE_HIGH>;

			ser_0_i2c_0: i2c@0 {
				#address-cells = <1>;
				#size-cells = <0>;

				reg = <0>;
				status = "okay";
			};
		};

		pipe@0 {
			reg = <0>;

			maxim,stream-id = <0>;
		};

		channel@0 {
			reg = <0>;
			label = "ser_0_ch_0";

			maxim,pipe-id = <0>;
			maxim,vc-id = <0>;

			clock-lanes = <0>;
			data-lanes = <1 2>;
			clock-noncontinuous;
		};
	};
};

&ser_0_i2c_0 {
	pca9554_cam_0: pca9554@21 {
		compatible = "nxp,pca9554";
		reg = <0x21>;
		gpio-controller;
		#gpio-cells = <2>;
		gpio-line-names = "EXPOSURE_TRIG_IN",
				  "FLASH_OUT",
				  "INFO_TRIG_IN",
				  "CAMA_SHUTTER",
				  "CSI_P1_nRST",
				  "PWR_TIME0",
				  "PWR_TIME1",
				  "3V3_EN";
		vcc-supply = <&vdd_1v8_hs>;
		vcc_lp = "vcc";
		status = "okay";
	};
};
