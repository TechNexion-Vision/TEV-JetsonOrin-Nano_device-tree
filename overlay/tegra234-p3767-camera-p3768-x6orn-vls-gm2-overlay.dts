			max_gain_val = "170";
			step_gain_val = "1";
			default_gain = "16";
			min_hdr_ratio = "1";
			max_hdr_ratio = "1";
			min_framerate = "2000000";
			max_framerate = "60000000";
			step_framerate = "1";
