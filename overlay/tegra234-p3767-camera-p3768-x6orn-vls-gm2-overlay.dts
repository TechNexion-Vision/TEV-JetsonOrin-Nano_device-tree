&ser_0_i2c_0 {
	pca9554_cam_0: pca9554@2a {
		compatible = "nxp,pca9554";
		reg = <0x2a>;
		gpio-controller;
		#gpio-cells = <2>;
		gpio-line-names = "EXPOSURE_TRIG_IN",
				"FLASH_OUT",
				"INFO_TRIG_IN",
				"CAMA_SHUTTER",
				"CSI_P1_nRST",
				"PWR_TIME0",
				"PWR_TIME1",
				"3V3_EN";
		vcc-supply = <&vdd_1v8_hs>;
		vcc_lp = "vcc";
		status = "okay";
	};
};

