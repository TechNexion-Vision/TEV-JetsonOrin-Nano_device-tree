{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://technexion.com/schemas/camera-device-tree-artifacts-v1.json",
  "title": "TechNexion camera device-tree artifact catalog v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "kind", "fragments"],
      "properties": {
        "schemaVersion": {"const": 1},
        "kind": {"const": "camera-device-tree-artifact-index"},
        "fragments": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^ci/camera-device-tree-artifacts/.+\\.json$"}
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "kind", "group", "artifacts"],
      "properties": {
        "schemaVersion": {"const": 1},
        "kind": {"const": "camera-device-tree-artifact-fragment"},
        "group": {"type": "string", "minLength": 1},
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id", "type", "output", "source", "makefile", "makeVariable",
              "platforms", "camera", "variant", "lifecycle"
            ],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$"},
              "type": {"enum": ["base-dtb", "camera-overlay"]},
              "output": {"type": "string", "pattern": "^[A-Za-z0-9_+.-]+\\.dtb(o)?$"},
              "source": {"type": "string", "pattern": "^[A-Za-z0-9_+./-]+\\.dts$"},
              "makefile": {"type": "string", "pattern": "(^|/)Makefile$"},
              "makeVariable": {"enum": ["dtb-y", "dtbo-y", null]},
              "platforms": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
              "camera": {"type": "string"},
              "variant": {"type": "string", "minLength": 1},
              "lifecycle": {"enum": ["supported", "experimental", "sourceOnly"]},
              "reason": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  ]
}
